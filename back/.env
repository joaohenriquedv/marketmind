PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=marketmind
JWT_SECRET=marketmind_secreto
# ---------- banco (já existentes) ----------

# ---------- OBRIGATÓRIO: URL pública do site ----------
# Local:      http://localhost:5173
# Produção:   https://marketmind.vercel.app
# Vários domínios: separe por vírgula
# FRONT_URL=http://localhost:5173

# ---------- Remetente que aparece no e-mail ----------
# MAIL_NOME=MarketMind
# MAIL_RELATORIO_PORT=3003
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000FROM=seuemail@gmail.com

# =====================================================
# ESCOLHA **UM** PROVEDOR (os três funcionam sem mexer no código)
# =====================================================

# --- OPÇÃO 1: Brevo (recomendado, HTTP, grátis 300/dia) ---
# 1. crie conta em brevo.com
# 2. Senders & IP > Add a sender > coloque seu Gmail e confirme o clique no e-mail
# 3. SMTP & API > API Keys > Create
# BREVO_API_KEY=xkeysib-...

# --- OPÇÃO 2: Resend (HTTP, grátis 100/dia; exige domínio verificado p/ enviar a terceiros) ---
# RESEND_API_KEY=re_...

# --- OPÇÃO 3: SMTP Gmail (precisa de senha de app, não da senha normal) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=abcdefghijklmnop
